# Copy this file to .env and fill it in. .env is never committed.

# From `npm run auth` (signs in to Ring with your two-factor code).
RING_REFRESH_TOKEN=

# A long random string. Type the same value into the dashboard's Settings tab.
DASHBOARD_TOKEN=

# Optional
PORT=8787
ALLOWED_ORIGIN=https://geedubyah2.github.io
SNAPSHOT_CACHE_SECONDS=30
# Sonos speaker IPs, comma separated, if the helper can't find them by itself
SONOS_HOSTS=
